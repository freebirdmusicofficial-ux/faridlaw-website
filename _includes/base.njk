<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | Farid & Farid</title>
<meta name="description" content="{{ description or summary or 'Insights from Farid & Farid Law Firm.' }}">

<!-- Link preview card (WhatsApp, iMessage, Facebook, LinkedIn, Slack, etc.) -->
{% set ogImage = "https://faridlaw.net/assets/og-image.jpg" %}
{% if image %}{% set ogImage = "https://faridlaw.net" + image %}{% endif %}
<meta property="og:type" content="{{ 'article' if date else 'website' }}">
<meta property="og:site_name" content="Farid & Farid Law Firm">
<meta property="og:title" content="{{ title }} | Farid & Farid">
<meta property="og:description" content="{{ description or summary or 'Insights from Farid & Farid Law Firm.' }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="https://faridlaw.net{{ page.url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} | Farid & Farid">
<meta name="twitter:description" content="{{ description or summary or 'Insights from Farid & Farid Law Firm.' }}">
<meta name="twitter:image" content="{{ ogImage }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream: #FAF6EE; --cream-deep: #F1E9D8;
    --ink: #1B1712; --ink-soft: #5B5147;
    --gold: #A5855D; --gold-deep: #8B6D45; --gold-pale: #D9C7A6;
    --charcoal: #1F1B16; --line: rgba(27,23,18,0.14);
    --serif: 'Fraunces', serif; --sans: 'Inter', sans-serif;
  }
  *{ margin:0; padding:0; box-sizing:border-box; }
  body{ font-family: var(--sans); background: var(--cream); color: var(--ink); line-height:1.65; -webkit-font-smoothing:antialiased; }
  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }
  .wrap{ max-width:900px; margin:0 auto; padding:0 32px; }
  header{ padding:26px 0; border-bottom:1px solid var(--line); }
  .nav-inner{ max-width:1200px; margin:0 auto; padding:0 40px; display:flex; align-items:center; justify-content:space-between; }
  .brand{ display:flex; align-items:center; gap:12px; }
  .brand img{ height:30px; width:auto; }
  .brand-text{ font-family: var(--serif); font-size:19px; font-weight:500; }
  .main-links{ display:flex; align-items:center; gap:36px; }
  .main-links a{ font-size:13.5px; font-weight:500; }
  .main-links a:hover{ color: var(--gold-deep); }
  main{ padding:80px 0 100px; min-height:60vh; }
  .eyebrow{ font-size:12.5px; font-weight:600; letter-spacing:0.22em; text-transform:uppercase; color: var(--gold-deep); margin-bottom:18px; }
  h1{ font-family: var(--serif); font-weight:400; font-size:clamp(32px,4.4vw,52px); line-height:1.12; letter-spacing:-0.01em; }
  footer{ background: var(--charcoal); color: rgba(250,246,238,0.6); padding:40px 0; margin-top:60px; }
  .footer-inner{ max-width:1200px; margin:0 auto; padding:0 40px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; font-size:12.5px; }
  .footer-inner a{ color: rgba(250,246,238,0.75); }
  @media (max-width:700px){ .nav-inner{ padding:0 20px; } .wrap{ padding:0 20px; } .footer-inner{ padding:0 20px; } .main-links{ gap:20px; } }
</style>
</head>
<body>
<header>
  <div class="nav-inner">
    <a href="/" class="brand">
      <img src="data:image/png;base64," alt="Farid & Farid crest">
      <span class="brand-text">Farid &amp; Farid</span>
    </a>
    <nav class="main-links">
      <a href="/">Home</a>
      <a href="/publications/">Publications</a>
      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>
<main>
  <div class="wrap">
    {{ content | safe }}
  </div>
</main>
<footer>
  <div class="footer-inner">
    <span>© 2026 Farid &amp; Farid Law Firm.</span>
    <a href="/">Back to homepage</a>
  </div>
</footer>
</body>
</html>
